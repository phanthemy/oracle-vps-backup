{
  "name": "hrm-unified",
  "displayName": "HRM Unified Platform",
  "repository": "https://github.com/phanthemy/hrm-unified.git",
  "branch": "main",
  "rootPath": "/var/www/hrm-unified",
  "domain": "hrm.nextapp.vn",
  "altDomains": [],
  "nodeVersion": "20",
  "pm2": {
    "name": "hrm-unified",
    "script": "npm",
    "args": "start",
    "cwd": "/var/www/hrm-unified/apps/web",
    "port": 3000,
    "env": {
      "PORT": "3000",
      "NODE_ENV": "production"
    }
  },
  "build": {
    "installCmd": "npm install --production=false",
    "buildCmd": "npm run build"
  },
  "database": {
    "type": "postgresql",
    "name": "hrm_unified_prod",
    "user": "hrm_user"
  },
  "healthCheck": {
    "url": "http://localhost:3000",
    "expectedStatus": 200
  }
}
