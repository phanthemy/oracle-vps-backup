server {

    listen 80;
    server_name chamcong.serveirc.com;
    return 301 https://$host$request_uri;
}

server {
    # SEO Setup
    location = /robots.txt {
        root /var/www/portfolio;
        access_log off;
        log_not_found off;
    }
    location = /sitemap.xml {
        root /var/www/portfolio;
        access_log off;
        log_not_found off;
    }
    location ~ ^/google[a-zA-Z0-9]+\.html$ {
        root /var/www/portfolio;
        access_log off;
        log_not_found off;
    }

    listen 443 ssl;
    server_name chamcong.serveirc.com;

    client_max_body_size 50M;

    ssl_certificate /etc/letsencrypt/live/chamcong.serveirc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chamcong.serveirc.com/privkey.pem;

    location / {
        root /var/www/chamcong/admin/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3015;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
