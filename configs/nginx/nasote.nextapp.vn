server {

    listen 80;
    server_name nasote.nextapp.vn;
    return 301 https://$host$request_uri;
}

server {
    # SEO Setup
    location = /robots.txt {
        root /var/www/portfolio;
        access_log off;
        log_not_found off;
    }
    location = /sitemap.xml {
        root /var/www/portfolio;
        access_log off;
        log_not_found off;
    }
    location ~ ^/google[a-zA-Z0-9]+\.html$ {
        root /var/www/portfolio;
        access_log off;
        log_not_found off;
    }

    listen 443 ssl http2;
    server_name nasote.nextapp.vn;

    ssl_certificate /etc/letsencrypt/live/nasote.nextapp.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nasote.nextapp.vn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /home/ubuntu/bachhoaonline/public;
    index index.html;

    # Static uploaded images - proxy to Express
    location /uploads/ {
        proxy_pass http://127.0.0.1:3016/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3016/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods 'GET, POST, PUT, DELETE, OPTIONS';
        add_header Access-Control-Allow-Headers 'Authorization, Content-Type';
        client_max_body_size 20m;
    }
}
