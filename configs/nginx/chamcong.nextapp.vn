server {
    listen 80;
    server_name chamcong.nextapp.vn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name chamcong.nextapp.vn;

    client_max_body_size 50M;

    ssl_certificate /etc/letsencrypt/live/chamcong.nextapp.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chamcong.nextapp.vn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # APK download - dùng location riêng thay vì override types{}
    location ~* \.apk$ {
        root /var/www/chamcong/admin/dist;
        add_header Content-Disposition 'attachment';
        add_header Content-Type 'application/vnd.android.package-archive';
    }

    location / {
        root /var/www/chamcong/admin/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3015;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
