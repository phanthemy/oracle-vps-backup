server {
    # SEO Setup
    location = /robots.txt {
        root /var/www/portfolio;
        access_log off;
        log_not_found off;
    }
    location = /sitemap.xml {
        root /var/www/portfolio;
        access_log off;
        log_not_found off;
    }
    location ~ ^/google[a-zA-Z0-9]+\.html$ {
        root /var/www/portfolio;
        access_log off;
        log_not_found off;
    }

    server_name dautayshop.nextapp.vn;
    client_max_body_size 20M;

    # Serve static uploads directly from Nginx (highest priority for /uploads/)
    location /uploads/ {
        alias /var/www/dautayshop/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Serve static assets (JS/CSS bundles) directly
    location /assets/ {
        root /var/www/dautayshop/client/dist;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Serve static files from client/dist ONLY (exclude /uploads/ and /api/)
    location ~* ^/(?!uploads/|api/|assets/).*\.(png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|csv|xlsx|mp4|webm|html)$ {
        root /var/www/dautayshop/client/dist;
        expires 7d;
        add_header Cache-Control "public";
    }

    # ALL other requests go through Express (API + SSR HTML)
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/dautayshop.nextapp.vn/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/dautayshop.nextapp.vn/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = dautayshop.nextapp.vn) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name dautayshop.nextapp.vn;
    return 404; # managed by Certbot
}
