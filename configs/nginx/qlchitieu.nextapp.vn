server {
    server_name qlchitieu.nextapp.vn;
    root /var/www/chitieu/frontend/dist;
    index index.html;

    location /assets {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api {
        proxy_pass http://localhost:3001/api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/qlchitieu.nextapp.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qlchitieu.nextapp.vn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
server {
    if ($host = qlchitieu.nextapp.vn) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    server_name qlchitieu.nextapp.vn;
    return 404;
}
