server {
    server_name parking.mapgo.vn;

    location /screenshots/ {
        alias /var/www/parking-manager/public/screenshots/;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location /review-package/ {
        alias /var/www/parking-manager/public/review-package/;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
    
    location / {
        proxy_pass http://localhost:3040;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        # SSE support
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/parking.mapgo.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/parking.mapgo.vn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = parking.mapgo.vn) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name parking.mapgo.vn;
    return 404;
}
