server {
    server_name dudoan.nextapp.vn;
    root /var/www/xoso-prediction;
    index index.html;

    location = /robots.txt {
        access_log off;
        log_not_found off;
    }
    location = /sitemap.xml {
        access_log off;
        log_not_found off;
    }
    location ~ ^/google[a-zA-Z0-9]+\.html$ {
        access_log off;
        log_not_found off;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    location ~* \.(js|css)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    location /api/xoso/ {
        proxy_pass https://xosonay.com/api/;
        proxy_ssl_server_name on;
        proxy_set_header Host xosonay.com;
        proxy_set_header Accept application/json;
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "public, max-age=300";
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/xml;
    gzip_min_length 256;

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/dudoan.nextapp.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dudoan.nextapp.vn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
server {
    if ($host = dudoan.nextapp.vn) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    server_name dudoan.nextapp.vn;
    return 404;
}
